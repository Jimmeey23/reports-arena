# Studio Intelligence - optional configuration
# Copy to .env and export before starting the server.
# Everything here is optional; without it the app runs fully local and
# deterministic (SQLite persistence, zero-token answers).

# ---- AI assistant (OpenAI-compatible) -------------------------------
# P57_AI_KEY=sk-...
# P57_AI_MODEL=gpt-4o-mini
# P57_AI_BASE=https://api.openai.com/v1/chat/completions

# ---- Supabase persistence -------------------------------------------
# Used for: chat history, structural edits, answer cache, the generated
# reports themselves (so reviews persist and earlier periods become AI
# comparison context), and non-secret app configuration.
# Without it, everything falls back to local SQLite in data/.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_KEY=eyJ...            # service_role or anon key with table access
# Tables (create once in the Supabase SQL editor; full DDL in ai/store.py):
#   chat_messages, report_edits, ai_cache, reports, app_config

# ---- misc -------------------------------------------------------------
# P57_WORKSPACE_DB=data/workspace.sqlite3
# DEMO_STUDIO=Supreme HQ, Bandra
# QUIET=1
